{
  "name": "hudson-ai-design-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-font.mjs",
    "build": "node generate.mjs",
    "check": "node --check dist/app.js && node generate.mjs",
    "start": "python3 -m http.server 8000 --directory dist",
