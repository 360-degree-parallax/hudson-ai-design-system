{
  "version": "1.0.0",
  "components": [
    {
      "id": "Button",
      "version": "1.0.0",
      "status": "stable",
      "purpose": "사용자가 명확한 행동을 실행하도록 돕는 버튼입니다.",
      "useWhen": "화면의 목적과 필요한 상태가 이 계약에 부합할 때",
      "avoidWhen": "기존 패턴으로 의미와 동작을 표현할 수 없을 때",
      "props": [
        {
          "name": "variant",
          "type": "enum",
          "default": "primary",
          "description": "시각적 행동 우선순위"
        },
        {
          "name": "size",
          "type": "sm | md | lg",
          "default": "md",
          "description": "보조·일반·주요 액션 크기"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false",
          "description": "중복 실행을 차단하고 라벨 유지"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "description": "실행 불가 상태"
        },
        {
          "name": "type",
          "type": "button | submit | reset",
          "default": "button",
          "description": "HTML 동작"
        },
        {
          "name": "children",
          "type": "ReactNode / text",
          "default": "필수",
          "description": "명확한 행동 라벨"
        }
      ],
      "variants": [
        "primary",
        "secondary",
        "ghost",
        "danger"
      ],
      "stateAxes": {
        "interaction": [
          "default",
          "hover",
          "pressed",
          "focus-visible"
        ],
        "availability": [
          "enabled",
          "disabled"
        ],
        "async": [
          "idle",
          "loading",
          "success",
          "error"
        ],
        "selection": [
          "unselected",
          "selected"
        ]
      },
      "statePrecedence": [
        "disabled",
        "loading",
        "invalid/selected",
        "interaction + focus-visible"
      ],
      "tokenBindings": {
        "background": "bg.surface",
        "text": "text.primary",
        "primaryAction": "action.primary.bg"
      },
      "keyboardBehavior": "Tab으로 접근, native 요소 또는 WAI-ARIA 패턴의 키보드 계약 준수",
      "accessibility": [
        "visible-focus",
        "accessible-name",
        "contrast-aa"
      ],
      "responsiveBehavior": "docs-default; 360px~1920px; 200% 글자·400% 브라우저 확대 검수",
      "i18nBehavior": "외부 문자열 주입, 한영 혼합, 긴 텍스트 50% 확장",
      "events": [
        "change",
        "activate"
      ],
      "examples": [
        "/components/button"
      ],
      "acceptanceCriteria": [
        "keyboard-complete",
        "no-page-overflow",
        "no-duplicate-action"
      ],
      "deprecatedReplacement": null
    },
