{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hudson ScreenBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "systemVersion",
    "screenId",
    "purpose",
    "audience",
    "primaryAction",
    "secondaryActions",
    "layout",
    "density",
    "theme",
    "contentPriority",
    "requiredStates",
    "dataSource",
    "responsivePolicy",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "systemVersion": {
      "const": "1.0.0"
    },
    "screenId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "designer",
          "developer",
          "ai"
        ]
      }
    },
    "primaryAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "actionId"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "actionId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secondaryActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layout": {
      "enum": [
        "DocsShell",
        "ProductShell",
        "MediaWorkspace"
      ]
    },
    "density": {
      "enum": [
        "comfortable",
        "compact"
      ]
    },
    "theme": {
      "enum": [
        "light",
        "inverse"
      ]
    },
    "contentPriority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requiredStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dataSource": {
      "type": "string",
      "minLength": 1
    },
    "responsivePolicy": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}