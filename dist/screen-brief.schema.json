{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hudson ScreenBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "systemVersion",
    "screenId",
    "purpose",
    "audience",
    "primaryAction",
    "secondaryActions",
    "layout",
    "density",
    "theme",
    "contentPriority",
    "requiredStates",
    "dataSource",
    "responsivePolicy",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "systemVersion": {
      "const": "1.0.0"
    },
    "screenId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "designer",
          "developer",
          "ai"
        ]
      }
    },
    "primaryAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "actionId"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "actionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "secondaryActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "layout": {
      "enum": [
        "DocsShell",
        "ProductShell",
        "MediaWorkspace"
      ]
    },
    "density": {
      "enum": [
        "comfortable",
        "compact"
      ]
    },
    "theme": {
      "enum": [
        "light",
        "inverse"
      ]
    },
    "allowedComponents": {
      "type": "array",
      "items": {
        "enum": [
          "Button",
          "Link",
          "Field",
          "TextInput",
          "Select",
          "Combobox",
          "Checkbox",
          "Radio",
          "Switch",
          "Tabs",
          "Badge",
          "Alert",
          "Toast",
          "Tooltip",
          "Dialog",
          "Drawer",
          "Table",
          "Pagination",
          "Skeleton",
          "Progress"
        ]
      }
    },
    "contentPriority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataSource": {
      "type": "string",
      "minLength": 1
    },
    "responsivePolicy": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}